# API
PORT=4000
DATABASE_URL=postgres://savorly:savorly@localhost:5433/savorly
JWT_SECRET=change-me
GEMINI_API_KEY=
APIFY_TOKEN=
# Optional. Defaults to apify/instagram-reel-scraper
# APIFY_INSTAGRAM_ACTOR=apify/instagram-reel-scraper
# Optional. Defaults to autofacts/youtube-subtitle-transcript-scraper
# APIFY_YOUTUBE_ACTOR=autofacts/youtube-subtitle-transcript-scraper
# Optional caption languages, first match wins. Defaults to en,nl
# APIFY_YOUTUBE_LANGUAGES=en,nl
USE_MOCK_IMPORTS=true
# Optional. Without this, diary USDA search uses a local staple list.
USDA_FDC_API_KEY=
# Optional. FatSecret Platform Basic (foods.search + food.get). Without these, FatSecret search is unavailable.
FATSECRET_CLIENT_ID=
FATSECRET_CLIENT_SECRET=
# Optional. Path to RIVM NEVO CSV when rebuilding apps/api/data/nevo/nevo2025-v9.0.json
# NEVO_CSV_PATH=C:/Users/you/Downloads/NEVO2025_v9.0/NEVO2025_v9.0.csv

# Seeded admin login (email shorthand: admin). Do not use "admin" as the password.
ADMIN_PASSWORD=change-me-at-least-8-chars

# Optional Gemini model override
GEMINI_MODEL=gemini-3.5-flash-lite

# Mobile (apps/mobile/.env)
EXPO_PUBLIC_API_URL=http://localhost:4000
