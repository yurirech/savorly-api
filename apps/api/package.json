{
  "name": "@savorly/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "start": "tsx src/index.ts",
    "start:hosted": "tsx src/db/migrate.ts && tsx src/index.ts",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file=.env src/db/migrate.ts"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@hono/node-server": "^1.14.4",
    "@savorly/shared": "*",
    "apify-client": "^2.12.1",
    "bcryptjs": "^3.0.2",
    "cheerio": "^1.1.0",
    "drizzle-orm": "^0.44.2",
    "hono": "^4.7.11",
    "jose": "^6.0.11",
    "postgres": "^3.4.7",
    "tsx": "^4.19.4",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.15.30",
    "drizzle-kit": "^0.31.1",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
